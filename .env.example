# Copia este archivo como .env.local para desarrollo local (nunca subas .env.local a GitHub).
# Estas mismas variables se configuran también en Vercel → Settings → Environment Variables.

# Se obtienen en Supabase → Project Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo se usan en el GitHub Action de reseteo diario (Settings → Secrets → Actions del repo),
# NUNCA en el frontend ni en Vercel.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta
